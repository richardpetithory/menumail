# Copy to Config/oauth-client.env (gitignored) to build MenuMail with a built-in OAuth client,
# so users can sign in without setting up Google Cloud themselves.
#
# Create the client in Google Cloud: Gmail API enabled, Google Auth Platform audience External
# and published, then Clients → Create client → Desktop app.
MENUMAIL_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"
MENUMAIL_CLIENT_SECRET="GOCSPX-..."
